+// Some apps (QQ, for example) draw their own application menu in the menu bar.
+// macOS shows that menu once, under the application's name, so fold a bar menu
+// whose label matches the focused app into the app-name button instead of
+// drawing a second identical button.
+export function splitBarMenus(nodes, appName) {
+	const topLevel = barNodes(nodes);
+	let appMenu = nodes.find(n => n.appMenu) ?? null;
+	if (!appMenu && appName) {
+		const duplicate = topLevel.find(n => stripMnemonic(n.label) === appName);
+		if (duplicate)
+			return {bar: topLevel.filter(n => n !== duplicate), appMenu: duplicate};
+	}
+	return {bar: topLevel, appMenu};
+}
